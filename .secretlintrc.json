{
    "rules": [
        {
            "id": "@secretlint/secretlint-rule-preset-recommend"
        },
        {
            "id": "@secretlint/secretlint-rule-pattern",
            "options": {
                "patterns": [
                    {
                        "name": "JSON Web Token (ex: clés Supabase anon/service_role)",
                        "patterns": ["/eyJ[A-Za-z0-9_-]{10,}\\.eyJ[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}/"]
                    },
                    {
                        "name": "Valeur assignée à une variable *_SECRET/*_KEY/*_TOKEN/*_PASSWORD",
                        "patterns": [
                            "/(SECRET|API_KEY|APIKEY|_TOKEN|PASSWORD)\\s*[:=]\\s*[\"']?(?<value>[A-Za-z0-9\\/+_-]{16,})/i"
                        ]
                    }
                ]
            }
        }
    ]
}
